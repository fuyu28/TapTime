{
  "compilerOptions": {
    // bun / hono デフォルト
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    // 追加分
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",

    "lib": ["es2022", "DOM"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["src", "drizzle.config.ts"]
}
